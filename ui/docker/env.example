# 复制成 .env 后按需修改；make_build_dir.sh 会自动生成一份

# ---- 预训练模型：想复用本机已下好的，就填绝对路径；留空用 ./models（首次自动下载 ~3.2GB）----
PRETRAINED_DIR=/绝对路径/GPT-SoVITS/GPT_SoVITS/pretrained_models
G2PW_DIR=/绝对路径/GPT-SoVITS/GPT_SoVITS/text/G2PWModel
NLTK_DIR=/绝对路径/GPT-SoVITS/nltk_data

# ---- 音色权重目录：目录下需要有 GPT_weights_v2Pro/ 、SoVITS_weights_v2Pro/ 这类子目录 ----
WEIGHTS_DIR=/绝对路径/GPT-SoVITS

# ---- 其它 ----
PORT=8000
AUTO_FETCH=0
HF_ENDPOINT=https://hf-mirror.com
PIP_INDEX=https://pypi.tuna.tsinghua.edu.cn/simple
TORCH_INDEX=https://mirrors.aliyun.com/pytorch-wheels/cpu
